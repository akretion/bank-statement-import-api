<odoo>

        <record id="account_statement_import_api_account_form" model="ir.ui.view">
                <field name="model">account.statement.import.api.account</field>
                <field name="arch" type="xml">
                        <form>
                                <group name="main">
                                        <field
                        name="statement_import_api_id"
                        invisible="not context.get('account_statement_import_api_account')"
                    />
                                        <field name="name" />
                                        <field name="account_number" />
                                        <field name="bank_name" />
                                        <field name="currency_id" />
                                        <field
                        name="connector_id"
                        attrs="{'invisible': [('is_aggregator', '=', False)]}"
                    />
                                        <field
                        name="account_type"
                        attrs="{'invisible': [('account_type', '=', False)]}"
                    />

                                        <field name="identifier" />
                                        <field name="company_id" />
                                        <field name="active" />
                                        <field name="service" invisible="1" />
                                        <field name="is_aggregator" invisible="1" />
                                </group>
                        </form>
                </field>
        </record>

    <record id="account_statement_import_api_account_parent_list" model="ir.ui.view">
            <field name="model">account.statement.import.api.account</field>
            <field name="priority">100</field>
                <field name="arch" type="xml">
                        <tree create="0" decoration-muted="not active">
                            <field
                    name="statement_import_api_id"
                    invisible="not context.get('account_statement_import_api_account')"
                />
                            <field name="name" />
                            <field name="account_number" />
                            <field name="bank_name" />
                            <field name="currency_id" optional="show" />
                            <field
                    name="connector_id"
                    attrs="{'column_invisible': [('parent.is_aggregator', '=', False)]}"
                />
                            <field
                    name="account_type"
                    attrs="{'invisible': [('account_type', '=', False)]}"
                    optional="show"
                />

                            <field name="identifier" optional="hide" />
                            <field name="company_id" optional="show" />
                            <field name="active" optional="show" />
                        </tree>
                </field>
        </record>

        <record id="account_statement_import_api_account_list" model="ir.ui.view">
                <field name="model">account.statement.import.api.account</field>
                <field name="arch" type="xml">
                        <tree create="0" decoration-muted="not active">
                            <field
                    name="statement_import_api_id"
                    invisible="not context.get('account_statement_import_api_account')"
                />
                            <field name="name" />
                            <field name="account_number" />
                            <field name="bank_name" />
                            <field name="currency_id" optional="show" />
                            <field
                    name="connector_id"
                    invisible="not context.get('account_statement_import_api_account')"
                />
                            <field
                    name="account_type"
                    attrs="{'invisible': [('account_type', '=', False)]}"
                    optional="show"
                />

                            <field name="identifier" optional="hide" />
                            <field name="company_id" optional="show" />
                            <field name="active" optional="show" />
                        </tree>
                </field>
        </record>

        <record id="account_statement_import_api_account_search" model="ir.ui.view">
                <field name="model">account.statement.import.api.account</field>
                <field name="arch" type="xml">
                        <search>
                                <field name="statement_import_api_id" />
                                <field
                    name="name"
                    filter_domain="['|', '|', '|', ('identifier', 'ilike', self), ('name', 'ilike', self), ('account_number', 'ilike', self), ('bank_name', 'ilike', self)]"
                    string="Label, Account Number, Bank Name or Identifier"
                />
                                <separator />
                                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
                                <group name="groupby">
                                    <filter
                        name="currency_groupby"
                        string="Currency"
                        context="{'group_by': 'currency_id'}"
                    />
                                </group>
                        </search>
                </field>
        </record>

        <record
        id="account_statement_import_api_account_action"
        model="ir.actions.act_window"
    >
                <field name="name">Statement Import API Accounts</field>
                <field name="res_model">account.statement.import.api.account</field>
                <field name="view_mode">tree,form</field>
                <field
            name="context"
        >{'account_statement_import_api_account': True}</field>
        </record>
</odoo>
