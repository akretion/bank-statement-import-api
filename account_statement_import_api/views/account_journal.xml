<odoo>

    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='bank_account_number']/field[@name='bank_statements_source']"
                position="after"
            >
            <separator
                    name="statement_import_api"
                    string="Bank Statement Import by API"
                    invisible="bank_statements_source != 'api'"
                    colspan="2"
                />
            <label
                    for="statement_import_api_id"
                    invisible="bank_statements_source != 'api'"
                />
            <div
                    name="statement_import_api_id"
                    invisible="bank_statements_source != 'api'"
                    class="o_row"
                >
                    <field
                        name="statement_import_api_id"
                        invisible="bank_statements_source != 'api'"
                        context="{'active_test': False}"
                        options="{'no_create': True, 'no_create_edit': True}"
                    />
                    <button
                        name="api_import_bank_statement_lines_button"
                        type="object"
                        string="Run Now"
                        help="Download bank statement lines via the API"
                        class="btn-link mb-1 px-0"
                        icon="fa-refresh"
                        invisible="not statement_import_api_account_id"
                    />
            </div>
            <field
                    name="statement_import_api_account_id"
                    invisible="bank_statements_source != 'api'"
                    required="statement_import_api_id"
                    options="{'no_create': True, 'no_create_edit': True}"
                />
            <field
                    name="statement_import_api_connector_id"
                    invisible="not statement_import_api_connector_id"
                />
            <label
                    for="statement_import_api_connector_auth_expiry_date"
                    invisible="not statement_import_api_connector_auth_expiry_date"
                />
            <div
                    name="statement_import_api_connector_auth_expiry_date"
                    invisible="not statement_import_api_connector_auth_expiry_date"
                    class="o_row"
                >
            <field
                        name="statement_import_api_connector_auth_expiry_date"
                        widget="badge"
                        decoration-warning="statement_import_api_connector_auth_expiry_warn_type == 'warning'"
                        decoration-danger="statement_import_api_connector_auth_expiry_warn_type == 'danger'"
                    />
                                                    <button
                        name="%(account_statement_import_api_generate_url_action)d"
                        type="action"
                        context="{'default_feature': 'renew_auth'}"
                        string="Extend"
                        class="btn-link mb-1 px-0"
                        icon="fa-refresh"
                    />

    </div>
            <field
                    name="statement_import_api_connector_auth_expiry_warn_type"
                    invisible="1"
                />
                    <field
                    name="statement_import_api_start_date"
                    invisible="bank_statements_source != 'api'"
                    readonly="statement_import_api_last_success"
                    required="statement_import_api_account_id == 'api' and not statement_import_api_last_success"
                />
                    <field
                    name="statement_import_api_last_success"
                    invisible="bank_statements_source != 'api'"
                />
                    <field name="statement_import_api_service" invisible="1" />
            </xpath>
            <div name="button_box" position="inside">
                <button
                    class="oe_stat_button"
                    type="action"
                    name="%(account_statement_import_api_log_action)d"
                    icon="fa-list-ul"
                    string="Import Logs"
                    context="{'search_default_journal_id': id}"
                    invisible="bank_statements_source != 'api'"
                />
            </div>
        </field>
    </record>

    <record id="view_account_journal_tree" model="ir.ui.view">
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_tree" />
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field
                    name="statement_import_api_id"
                    optional="hide"
                    invisible="type != 'bank'"
                />
            </field>
        </field>
    </record>

    <record id="account_journal_dashboard_kanban_view" model="ir.ui.view">
            <field name="model">account.journal</field>
            <field
            name="inherit_id"
            ref="account.account_journal_dashboard_kanban_view"
        />
            <field name="arch" type="xml">
                    <field name="id" position="after">
                            <field name="statement_import_api_id" />
                            <field name="statement_import_api_connector_id" />
                            <field name="statement_import_api_account_id" />
                            <field
                    name="statement_import_api_connector_auth_expiry_date"
                />
                            <field
                    name="statement_import_api_connector_auth_expiry_warn_type"
                />
                    </field>
                    <xpath
                expr="//t[@t-name='menu']//div[@id='bank_and_cash_container']//div[@name='kanban_manage_new']"
                position="after"
            >
                                            <div
                    class="col-4"
                    groups="account.group_account_basic"
                    name="kanban_manage_operations"
                    t-if="record.statement_import_api_id.raw_value"
                >
                            <h5 class="o_kanban_card_manage_title">
                                <span role="separator">Operations</span>
                            </h5>
                        <div t-if="record.statement_import_api_id.raw_value">
                            <a
                            role="menuitem"
                            type="object"
                            name="api_import_bank_statement_lines_button"
                        >Re-sync Now</a>
                    </div>
                    </div>
                </xpath>
                <xpath
                expr="//t[@t-name='menu']//a[@name='open_payments_action']/.."
                position="before"
            >
                        <div t-if="record.statement_import_api_account_id.raw_value">
                            <a
                        role="menuitem"
                        type="action"
                        name="%(account_statement_import_api_log_action)d"
                        context="{'search_default_journal_id': id}"
                    >Statement Import Logs</a>
                        </div>
                </xpath>
                <xpath expr="//div[@name='latest_statement']/.." position="after">
                        <div
                    class="row"
                    name="statement_import_api_connector_sync_status"
                    t-if="record.statement_import_api_connector_id.raw_value"
                >
                                    <div class="col overflow-hidden text-start">
                                        <span
                            title="Bank Connector"
                        >Bank Connector Status</span>
                                    </div>
                                    <div class="col-auto text-end">
                                            <field
                            name="statement_import_api_connector_sync_status"
                            widget="badge"
                            decoration-success="statement_import_api_connector_sync_status == 'ok'"
                            decoration-warning="statement_import_api_connector_sync_status == 'warning'"
                            decoration-danger="statement_import_api_connector_sync_status == 'ko'"
                        />
                                    </div>
                            </div>
                        <div
                    class="row"
                    name="statement_import_api_connector_auth_expiry_date"
                    t-if="record.statement_import_api_connector_auth_expiry_date.raw_value and record.statement_import_api_connector_auth_expiry_warn_type.raw_value"
                >
                                    <div class="col overflow-hidden text-start">
                                        <span
                            title="Bank Connector"
                        >Bank Connector Expiry</span>
                                    </div>
                                    <div class="col-auto text-end">
                                            <field
                            name="statement_import_api_connector_auth_expiry_date"
                            widget="badge"
                            decoration-warning="statement_import_api_connector_auth_expiry_warn_type == 'warning'"
                            decoration-danger="statement_import_api_connector_auth_expiry_warn_type == 'danger'"
                        />
                                                    <button
                            name="%(account_statement_import_api_generate_url_action)d"
                            type="action"
                            context="{'default_feature': 'renew_auth'}"
                            string="Extend"
                            icon="fa-refresh"
                        />
                                    </div>
                                </div>

                </xpath>
            </field>
    </record>

    <record id="view_account_journal_search" model="ir.ui.view">
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_search" />
            <field name="arch" type="xml">
                <field name="name" position="after">
                        <field name="statement_import_api_id" />
                </field>
            </field>
    </record>

<record id="account_bank_journal_action" model="ir.actions.act_window">
            <field name="name">Bank Journals</field>
            <field name="res_model">account.journal</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('type', '=', 'bank')]</field>
    </record>

</odoo>
