<odoo>

        <record id="account_statement_import_api_connector_form" model="ir.ui.view">
                <field name="model">account.statement.import.api.connector</field>
                <field name="arch" type="xml">
                        <form>
                                <header>
                            <button
                        name="%(account_statement_import_api_generate_url_action)d"
                        type="action"
                        context="{'default_feature': 'renew_auth'}"
                        string="Extend Authorization"
                    />
                            <button
                        name="%(account_statement_import_api_delete_connector_action)d"
                        type="action"
                        string="Delete Connector"
                    />

                                </header>
                                <div
                    class="alert alert-warning"
                    role="alert"
                    attrs="{'invisible': ['|', ('sync_status', '=', 'ok'), ('sync_status_message', '=', False)]}"
                >
                  <field name="sync_status_message" />
                        </div>
                <div class="oe_title">
                  <label for="name" />
                  <h1>
                                        <field name="name" />

                  </h1>
                        </div>
                                <group name="main">
                                        <field
                        name="statement_import_api_id"
                        invisible="not context.get('account_statement_import_api_connector_main_view')"
                    />
                                        <field name="name" />
                                        <field name="identifier" />
                                        <field
                        name="sync_status"
                        widget="badge"
                        decoration-success="sync_status == 'ok'"
                        decoration-warning="sync_status == 'warning'"
                        decoration-danger="sync_status == 'ko'"
                    />
                                        <field
                        name="sync_status_message"
                        attrs="{'invisible': [('sync_status', '!=', 'ok')]}"
                    />
                                        <field
                        name="auth_expiry_date"
                        widget="badge"
                        decoration-warning="auth_expiry_warn_type == 'warning'"
                        decoration-danger="auth_expiry_warn_type == 'danger'"
                    />
                                        <field name="last_sync_datetime" />
                                        <field
                        name="auth_expiry_warn_type"
                        invisible="1"
                    />
                                        <field
                        name="company_id"
                        groups="base.group_multi_company"
                    />
                                </group>
                                                            <group
                    name="api_accounts"
                    string="API Bank Accounts"
                >
                                                                    <field
                        name="api_account_ids"
                        nolabel="1"
                        colspan="2"
                    />
                                </group>
                                <group
                    name="status_history"
                    string="Sync Status History"
                >
                                        <field
                        name="sync_status_ids"
                        nolabel="1"
                        colspan="2"
                    />
                                </group>

                        </form>
                </field>
        </record>

    <record id="account_statement_import_api_connector_list" model="ir.ui.view">
                <field name="model">account.statement.import.api.connector</field>
                <field name="arch" type="xml">
                        <tree create="0">
                            <field
                    name="statement_import_api_id"
                    invisible="not context.get('account_statement_import_api_connector_main_view')"
                />
                            <field name="name" />
                            <field name="identifier" optional="hide" />
                            <field
                    name="sync_status"
                    widget="badge"
                    decoration-success="sync_status == 'ok'"
                    decoration-warning="sync_status == 'warning'"
                    decoration-danger="sync_status == 'ko'"
                />
                            <field name="sync_status_message" optional="show" />
                            <field
                    name="auth_expiry_date"
                    optional="show"
                    widget="badge"
                    decoration-warning="auth_expiry_warn_type == 'warning'"
                    decoration-danger="auth_expiry_warn_type == 'danger'"
                />
                            <button
                    name="%(account_statement_import_api_generate_url_action)d"
                    type="action"
                    context="{'default_feature': 'renew_auth'}"
                    string="Extend Authorization"
                    icon="fa-refresh"
                />
                            <field name="auth_expiry_warn_type" invisible="1" />
                            <field name="last_sync_datetime" optional="hide" />
                            <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="hide"
                />
                        </tree>
                </field>
        </record>

        <record id="account_statement_import_api_connector_search" model="ir.ui.view">
                <field name="model">account.statement.import.api.connector</field>
                <field name="arch" type="xml">
                        <search>
                                <field name="statement_import_api_id" />
                                <field
                    name="name"
                    filter_domain="['|', ('identifier', 'ilike', self), ('name', 'ilike', self)]"
                    string="Name or Identifier"
                />
                        </search>
                </field>
        </record>

        <record
        id="account_statement_import_api_connector_action"
        model="ir.actions.act_window"
    >
                <field name="name">Statement Import API Connector</field>
                <field name="res_model">account.statement.import.api.connector</field>
                <field name="view_mode">tree,form</field>
                <field
            name="context"
        >{'account_statement_import_api_connector_main_view': True}</field>
        </record>


</odoo>
