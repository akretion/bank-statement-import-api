<odoo>

<record id="account_statement_import_api_connector_status_form" model="ir.ui.view">
                <field
            name="model"
        >account.statement.import.api.connector.status</field>
                <field name="arch" type="xml">
                        <form>
                                <group>
                                        <field
                        name="statement_import_api_id"
                        invisible="not context.get('api_connector_status_main_view')"
                    />
                                        <field
                        name="connector_id"
                        invisible="not context.get('api_connector_status_main_view')"
                    />
                                        <field
                        name="company_id"
                        groups="base.group_multi_company"
                    />
                                        <field
                        name="create_date"
                        string="Change Date"
                    />
                                        <field name="sync_status" />
                                        <field name="sync_status_message" />
                                </group>
                    </form>
            </field>
    </record>

    <record id="account_statement_import_api_connector_status_list" model="ir.ui.view">
                <field
            name="model"
        >account.statement.import.api.connector.status</field>
                <field name="arch" type="xml">
                        <list
                decoration-danger="sync_status == 'ko'"
                decoration-warning="sync_status == 'warning'"
            >
                            <field
                    name="statement_import_api_id"
                    invisible="not context.get('api_connector_status_main_view')"
                />
                                        <field
                    name="connector_id"
                    invisible="not context.get('api_connector_status_main_view')"
                />
                                        <field
                    name="create_date"
                    string="Change Date"
                />
                                        <field
                    name="sync_status"
                    widget="badge"
                    decoration-success="sync_status == 'ok'"
                    decoration-warning="sync_status == 'warning'"
                    decoration-danger="sync_status == 'ko'"
                />
                                        <field name="sync_status_message" />
                        </list>
                </field>
        </record>

        <record
        id="account_statement_import_api_connector_status_search"
        model="ir.ui.view"
    >
                <field
            name="model"
        >account.statement.import.api.connector.status</field>
                <field name="arch" type="xml">
                        <search>
                            <field name="sync_status_message" />
                            <field name="connector_id" />
                            <field name="statement_import_api_id" />
                            <filter
                    name="ok"
                    string="Ok Status"
                    domain="[('sync_status', '=', 'ok')]"
                />
                            <filter
                    name="warning"
                    string="Warning Status"
                    domain="[('sync_status', '=', 'warning')]"
                />
                            <filter
                    name="ko"
                    string="Not Working"
                    domain="[('sync_status', '=', 'ko')]"
                />
                            <separator />
                            <filter
                    string="Change Date"
                    name="create_date"
                    date="create_date"
                />
                            <group name="groupby">
                                <filter
                        name="sync_status_groupby"
                        string="Sync Status"
                        context="{'group_by': 'sync_status'}"
                    />
                                <filter
                        name="connector_groupby"
                        string="Connector"
                        context="{'group_by': 'connector_id'}"
                    />
                                <filter
                        name="statement_import_api_groupby"
                        string="Bank Statement Import API"
                        context="{'group_by': 'statement_import_api_id'}"
                    />

                            </group>
                        </search>
                </field>
        </record>

        <record
        id="account_statement_import_api_connector_status_action"
        model="ir.actions.act_window"
    >
                <field name="name">Connector Status History</field>
                <field
            name="res_model"
        >account.statement.import.api.connector.status</field>
                <field name="view_mode">list,form</field>
                <field name="context">{"api_connector_status_main_view": True}</field>
        </record>

</odoo>
