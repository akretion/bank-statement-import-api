<odoo>

    <record id="account_statement_import_api_form" model="ir.ui.view">
        <field name="model">account.statement.import.api</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="%(account_statement_import_api_create_user_action)d"
                        type="action"
                        string="Create User"
                        class="btn-primary"
                        invisible="user_identifier or not user_identifier_required"
                        groups="account.group_account_manager"
                    />
                    <button
                        name="run_import"
                        type="object"
                        string="Run Now"
                        class="btn-primary"
                        groups="account.group_account_manager"
                        invisible="not journal_ids"
                    />
                    <button
                        name="test_api"
                        type="object"
                        string="Test API"
                        groups="account.group_account_manager"
                    />

                    <button
                        name="%(account_statement_import_api_generate_url_action)d"
                        type="action"
                        string="Add API Bank Accounts"
                        invisible="not is_aggregator or (user_identifier_required and not user_identifier)"
                        context="{'default_feature': 'add_account'}"
                        groups="account.group_account_manager"
                    />
                    <button
                        name="update_api_accounts"
                        type="object"
                        string="Get/Update API Bank Accounts"
                        groups="account.group_account_manager"
                        invisible="not service or (user_identifier_required and not user_identifier)"
                    />
                    <button
                        name="%(account_statement_import_api_generate_url_action)d"
                        type="action"
                        string="Manage API Bank Accounts"
                        invisible="not show_manage_accounts_wizard or (user_identifier_required and not user_identifier)"
                        context="{'default_feature': 'manage_accounts'}"
                        groups="account.group_account_manager"
                    />
                    <button
                        name="%(account_statement_import_api_delete_connector_action)d"
                        type="action"
                        string="Delete Connector"
                        groups="account.group_account_manager"
                        invisible="not is_aggregator or not connector_ids"
                    />
                    <button
                        name="%(account_statement_import_api_delete_user_action)d"
                        type="action"
                        string="Delete User"
                        groups="account.group_account_manager"
                        invisible="not user_identifier or not user_identifier_required"
                    />
                    <button
                        name="open_cron"
                        type="object"
                        string="Edit Scheduled Action"
                        groups="base.group_system"
                    />

                </header>
                <sheet>
                        <div class="oe_button_box" name="button_box">
                                <button
                            class="oe_stat_button"
                            type="action"
                            name="%(account_bank_journal_action)d"
                            context="{'search_default_statement_import_api_id': id, 'default_type': 'bank'}"
                            icon="fa-newspaper-o"
                            string="Bank Journals"
                        />
                                <button
                            class="oe_stat_button"
                            type="action"
                            name="%(account_statement_import_api.account_statement_import_api_log_action)d"
                            context="{'search_default_statement_import_api_id': id}"
                            icon="fa-bars"
                            string="Logs"
                        />
                                <button
                            class="oe_stat_button"
                            type="action"
                            name="%(account_statement_import_api.account_statement_import_api_connector_status_action)d"
                            context="{'search_default_statement_import_api_id': id}"
                            icon="fa-history"
                            string="Sync Status History"
                            invisible="not is_aggregator"
                        />

                </div>
                <div class="oe_title">
                    <label for="name" />
                    <h1>
                        <field name="name" />
                    </h1>
                </div>
                <group name="main">
                <group name="main-left">
                    <field name="service" readonly="api_account_ids" />
                    <field
                                name="company_id"
                                groups="base.group_multi_company"
                                readonly="api_account_ids"
                            />
                    <field name="company_id" invisible="1" />
                    <field name="show_manage_accounts_wizard" invisible="1" />
                    <field name="is_aggregator" invisible="1" />
                    <field name="last_success" />
                </group>
                <group name="main-right">
                    <field
                                name="login"
                                invisible="not show_login"
                                required="show_login"
                            />
                    <field
                                name="password"
                                password="1"
                                invisible="not show_password"
                                required="show_password"
                            />
                    <field name="show_login" invisible="1" />
                    <field name="show_password" invisible="1" />
                    <field name="tz" />
                    <field
                                name="user_identifier"
                                invisible="not user_identifier_required"
                            />
                    <field name="user_identifier_required" invisible="1" />
                </group>
        </group>
        <group name="instructions">
                <field name="instructions" nolabel="1" colspan="2" />
        </group>
        <notebook>
        <page name="connectors" string="Bank Connectors" invisible="not is_aggregator">
                <group name="connectors-main">
                        <field name="connector_ids" nolabel="1" colspan="2" />
                </group>
        </page>
            <page name="api_accounts" string="API Bank Accounts">
                <group name="active_api_accounts" string="Active API accounts">
                        <field
                                    name="active_api_account_ids"
                                    nolabel="1"
                                    colspan="2"
                                    context="{'list_view_ref': 'account_statement_import_api.account_statement_import_api_account_parent_list'}"
                                />
                </group>
                <group name="inactive_api_accounts" string="Inactive API accounts">
                        <field
                                    name="inactive_api_account_ids"
                                    nolabel="1"
                                    colspan="2"
                                    context="{'list_view_ref': 'account_statement_import_api.account_statement_import_api_account_parent_list'}"
                                />
                </group>
        </page>
                <page name="journals" string="Bank Journals">
                        <field
                                name="journal_ids"
                                nolabel="1"
                                colspan="2"
                                widget="many2many"
                            >
                        <list>
                        <field name="display_name" string="Name" />
                        <field name="statement_import_api_account_id" />
                        <field name="statement_import_api_start_date" />
                        <field name="statement_import_api_last_success" />
                </list>
                </field>
        </page>
                <page name="logs" string="Logs">
                    <field name="log_ids" nolabel="1" colspan="2" />
                </page>
        </notebook>
        </sheet>
            </form>
        </field>
    </record>

    <record id="account_statement_import_api_tree" model="ir.ui.view">
        <field name="model">account.statement.import.api</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" decoration-bf="1" />
                <field name="service" />
                <field name="journal_ids" widget="many2many_tags" />
                <field name="tz" optional="hide" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                />
            </list>
        </field>
    </record>

    <record id="account_statement_import_api_search" model="ir.ui.view">
        <field name="model">account.statement.import.api</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <group name="groupby">
                    <filter name="service_groupby" context="{'group_by': 'service'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="account_statement_import_api_action" model="ir.actions.act_window">
        <field name="name">Bank Statement Import API</field>
        <field name="res_model">account.statement.import.api</field>
        <field name="view_mode">list,form</field>
        <!-- 'active_test': False to display inactive API bank accounts -->
        <field
            name="context"
        >{'import_api_main_view': True, 'active_test': False}</field>
    </record>

    <menuitem
        id="account_statement_import_api_menu"
        action="account_statement_import_api_action"
        parent="account.account_banks_menu"
        sequence="100"
    />

</odoo>
