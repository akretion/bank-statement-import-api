<odoo>

    <record id="account_statement_import_api_form" model="ir.ui.view">
        <field name="model">account.statement.import.api</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="create_cron"
                        type="object"
                        string="Create Scheduled Action"
                        class="btn-primary"
                        attrs="{'invisible': [('cron_id', '!=', False)]}"
                        groups="account.group_account_manager"
                    />
                    <button
                        name="test_api"
                        type="object"
                        string="Test API"
                        groups="account.group_account_manager"
                    />
                    <button
                        name="update_api_accounts"
                        type="object"
                        string="Get/Update API Bank Accounts"
                        class="btn-primary"
                        groups="account.group_account_manager"
                        attrs="{'invisible': [('service', '=', False)]}"
                    />
                    <button
                        name="run_import"
                        type="object"
                        string="Run Now"
                        class="btn-primary"
                        groups="account.group_account_manager"
                    />
                </header>
                <sheet>
                        <div class="oe_button_box" name="button_box">
                                <button
                            class="oe_stat_button"
                            type="action"
                            name="%(account_statement_import_api.account_statement_import_api_log_action)d"
                            context="{'search_default_statement_import_api_id': active_id}"
                            icon="fa-bars"
                            string="Logs"
                        />
                </div>
                <div class="oe_title">
                    <label for="name" />
                    <h1>
                        <field name="name" />
                    </h1>
                </div>
                <group name="main">
                <group name="main-left">
                    <field name="service" />
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="company_id" invisible="1" />
                    <field name="cron_id" />
                    <field name="last_success" />
                </group>
                <group name="main-right">
                    <field name="login" />
                    <field name="password" password="1" />
                    <field
                                name="backward_days"
                                attrs="{'invisible': [('show_backward_days', '=', False)]}"
                            />
                    <field name="show_backward_days" invisible="1" />
                    <field name="show_company_user" invisible="1" />
                    <field name="tz" />
                </group>
        </group>
        <group name="instructions">
                <field name="instructions" nolabel="1" colspan="2" />
        </group>
        <notebook>
                <page name="journals" string="Bank Journals">
                <field name="journal_ids" nolabel="1" colspan="2">
                        <tree>
                        <field name="display_name" />
                        <field name="statement_import_api_account_id" />
                        <field name="statement_import_api_start_date" />
                        <field name="statement_import_api_last_success" />
                </tree>
                </field>
        </page>
        <page
                            name="company-users"
                            string="Per-Company Users"
                            attrs="{'invisible': [('show_company_user', '=', False)]}"
                        >
                <field name="company_user_ids" nolabel="1" colspan="2">
                        <tree editable="bottom">
                                <field name="company_id" />
                                <field name="identifier" />
                        </tree>
                </field>
        </page>
                <page name="api_accounts" string="API Bank Accounts">
                    <field name="api_account_ids" nolabel="1" colspan="2" />
                </page>
                <page name="logs" string="Logs">
                    <field name="log_ids" nolabel="1" colspan="2" />
                </page>
        </notebook>
        </sheet>
            </form>
        </field>
    </record>

    <record id="account_statement_import_api_tree" model="ir.ui.view">
        <field name="model">account.statement.import.api</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" decoration-bf="1" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="service" />
                <field name="journal_ids" widget="many2many_tags" />
                <field name="cron_id" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="account_statement_import_api_search" model="ir.ui.view">
        <field name="model">account.statement.import.api</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter
                    string="Automatic"
                    name="auto"
                    domain="[('cron_id', '!=', False)]"
                />
                <filter
                    string="Manual"
                    name="manual"
                    domain="[('cron_id', '=', False)]"
                />
                <group name="groupby">
                    <filter name="service_groupby" context="{'group_by': 'service'}" />
                    <filter
                        name="company_groupby"
                        context="{'group_by': 'company_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="account_statement_import_api_action" model="ir.actions.act_window">
        <field name="name">Bank Statement Import API</field>
        <field name="res_model">account.statement.import.api</field>
        <field name="view_mode">tree,form</field>
        <!-- 'active_test': False to display inactive API bank accounts -->
        <field
            name="context"
        >{'import_api_main_view': True, 'active_test': False}</field>
    </record>

    <menuitem
        id="account_statement_import_api_menu"
        action="account_statement_import_api_action"
        parent="account.account_banks_menu"
        sequence="100"
    />

</odoo>
