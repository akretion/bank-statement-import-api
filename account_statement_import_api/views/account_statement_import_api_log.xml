<odoo>

        <record id="account_statement_import_api_log_form" model="ir.ui.view">
                <field name="model">account.statement.import.api.log</field>
                <field name="arch" type="xml">
                        <form>
                                <group name="main">
                                    <group name="main-left">
                                            <field name="statement_import_api_id" />
                                            <field name="type" />
                                            <field
                            name="journal_id"
                            attrs="{'invisible': [('journal_id', '=', False)]}"
                        />
                                        <field name="create_date" string="Date" />
                                        <field
                            name="company_id"
                            groups="base.group_multi_company"
                        />
                                </group>
                                    <group name="main-right">
                                        <field
                            name="status"
                            widget="badge"
                            decoration-success="status == 'success'"
                            decoration-danger="status == 'failure'"
                            decoration-warning="status == 'success_warn'"
                        />
                                        <field name="new_line_count" />
                                        <field name="updated_line_count" />

                                </group>
                                </group>
                                <group name="logs" string="Logs">
                                        <field name="logs" nolabel="1" colspan="2" />
                                </group>
                        </form>
                </field>
        </record>

    <record id="account_statement_import_api_log_list" model="ir.ui.view">
                <field name="model">account.statement.import.api.log</field>
                <field name="arch" type="xml">
                        <tree decoration-danger="status == 'failure'">
                                <field
                    name="statement_import_api_id"
                    invisible="not context.get('api_log_main_view')"
                />
                                <field
                    name="type"
                    decoration-info="type == 'statement_line'"
                    widget="badge"
                />
                                <field name="journal_id" />
                                <field name="create_date" string="Date" />
                                <field
                    name="status"
                    widget="badge"
                    decoration-success="status == 'success'"
                    decoration-danger="status == 'failure'"
                    decoration-warning="status == 'success_warn'"
                />
                                <field
                    name="new_line_count"
                    optional="show"
                    string="New Lines"
                    sum="1"
                />
                                <field
                    name="updated_line_count"
                    optional="show"
                    string="Updated Lines"
                    sum="1"
                />
                        </tree>
                </field>
        </record>

        <record id="account_statement_import_api_log_search" model="ir.ui.view">
                <field name="model">account.statement.import.api.log</field>
                <field name="arch" type="xml">
                        <search>
                                <field name="statement_import_api_id" />
                                <field name="journal_id" />
                                <separator />
                                <filter
                    name="success"
                    string="Success"
                    domain="[('status', '=', 'success')]"
                />
                                <filter
                    name="success_warn"
                    string="Success with Warnings"
                    domain="[('status', '=', 'success_warn')]"
                />
                                <filter
                    name="failure"
                    string="Failure"
                    domain="[('status', '=', 'failure')]"
                />
                                <separator />
                                <filter
                    name="type_statement_line"
                    string="Bank Statement Lines Update"
                    domain="[('type', '=', 'statement_line')]"
                />
                                <filter
                    name="type_other"
                    string="Get Balances and Update Connectors"
                    domain="[('type', '=', 'other')]"
                />
                                <group name="groupby">
                                        <filter
                        name="type_groupby"
                        string="Type"
                        context="{'group_by': 'type'}"
                    />
                                        <filter
                        name="create_date_groupby"
                        string="Date"
                        context="{'group_by': 'create_date'}"
                    />
                                        <filter
                        name="status_groupby"
                        string="Status"
                        context="{'group_by': 'status'}"
                    />
                                        <filter
                        name="journal_groupby"
                        string="Bank Journal"
                        context="{'group_by': 'journal_id'}"
                    />
                                </group>
                        </search>
                </field>
        </record>

        <record
        id="account_statement_import_api_log_action"
        model="ir.actions.act_window"
    >
                <field name="name">Bank Statement Import API Logs</field>
                <field name="res_model">account.statement.import.api.log</field>
                <field name="view_mode">tree,form</field>
                <field name="context">{'api_log_main_view': True}</field>
        </record>
</odoo>
