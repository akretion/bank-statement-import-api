<odoo>

                  <record
        id="account_statement_import_api_delete_user_form"
        model="ir.ui.view"
    >
                          <field
            name="model"
        >account.statement.import.api.delete.user</field>
                          <field name="arch" type="xml">
                                  <form>
                                          <div id="help">
                                                  <p><strong
                            >If you confirm, Odoo will delete all the API bank accounts and connectors of this bank statement import API and you will not be able to call the API of this provider any more.</strong></p>
                                          </div>
                                          <group name="main">

                                                  <field
                        name="statement_import_api_id"
                    />
                                                  <field name="confirm" />
                                          </group>
                                          <footer>
                                                  <button
                        name="run"
                        type="object"
                        string="Delete User"
                        class="btn-primary"
                    />
                                                  <button
                        special="cancel"
                        string="Cancel"
                        class="btn-default"
                    />
                                          </footer>
                                  </form>
                          </field>
                  </record>

                  <record
        id="account_statement_import_api_delete_user_action"
        model="ir.actions.act_window"
    >
    <field name="name">Delete a User</field>
    <field name="res_model">account.statement.import.api.delete.user</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    </record>

          </odoo>
