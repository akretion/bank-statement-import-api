<odoo>

                  <record
        id="account_statement_import_api_delete_user_form"
        model="ir.ui.view"
    >
                          <field
            name="model"
        >account.statement.import.api.delete.user</field>
                          <field name="arch" type="xml">
                                  <form>
                                          <group name="main">
                                                  <field
                        name="company_user_id"
                        required="1"
                    />
                                                  <field name="company_id" />
                                                  <field
                        name="statement_import_api_id"
                    />
                                          </group>
                                          <div id="help">
                                                  <p><strong
                        >If you confirm, Odoo will delete all the API bank account of this bank statement import API in the related company and you will not be able to do anything with this provider in the related company.</strong></p>
                                          </div>
                                          <footer>
                                                  <button
                        name="run"
                        type="object"
                        string="Confirm Deletion"
                        class="btn-primary"
                    />
                                                  <button
                        special="cancel"
                        string="Cancel"
                        class="btn-default"
                    />
                                          </footer>
                                  </form>
                          </field>
                  </record>

                  <record
        id="account_statement_import_api_delete_user_action"
        model="ir.actions.act_window"
    >
    <field name="name">Delete a Per-Company User</field>
    <field name="res_model">account.statement.import.api.delete.user</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    </record>

          </odoo>
