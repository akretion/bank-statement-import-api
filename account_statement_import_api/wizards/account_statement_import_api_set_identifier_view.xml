<odoo>

    <record id="account_statement_import_api_set_identifier_form" model="ir.ui.view">
        <field name="model">account.statement.import.api.set.identifier</field>
        <field name="arch" type="xml">
            <form>
                <group name="main">
                    <field name="journal_id" />
                    <field
                        name="bank_account_id"
                        attrs="{'invisible': [('bank_account_id', '=', False)]}"
                    />
                    <field name="line_id" required="1" />
                </group>
                <group name="lines" string="Available Accounts">
                    <field name="line_ids" nolabel="1" colspan="2">
                        <tree>
                            <field name="name" />
                            <field name="account_number" />
                            <field name="bank_name" />
                            <field name="account_type" />
                            <field name="identifier" groups="base.group_no_one" />
                        </tree>
                    </field>
                </group>
                <footer>
                    <button
                        name="validate"
                        type="object"
                        string="Validate"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-default" />
                </footer>
            </form>
        </field>
    </record>


</odoo>
