<odoo>

                  <record
        id="account_statement_import_api_delete_connector_form"
        model="ir.ui.view"
    >
                          <field
            name="model"
        >account.statement.import.api.delete.connector</field>
                          <field name="arch" type="xml">
                                  <form>
                                          <group name="main">
                                                  <div colspan="2">
                                                        <p
                        >This wizard allows to delete a connector and all it's related API Bank Accounts. The deletion will happen in Odoo and also at the bank aggregator. <strong
                            >Don't use it if you don't know what you are doing!</strong></p>
    </div>

                                                  <field
                        name="statement_import_api_id"
                    />
                                                  <field name="service" invisible="1" />
                                                  <field name="connector_id" />
                                                  <field name="confirm" />
                                          </group>
                                          <footer>
                                                  <button
                        name="run"
                        type="object"
                        string="Delete Connector"
                        class="btn-primary"
                    />
                                                  <button
                        special="cancel"
                        string="Cancel"
                        class="btn-default"
                    />
                                          </footer>
                                  </form>
                          </field>
                  </record>

                  <record
        id="account_statement_import_api_delete_connector_action"
        model="ir.actions.act_window"
    >
    <field name="name">Delete a connector</field>
    <field name="res_model">account.statement.import.api.delete.connector</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    </record>

          </odoo>
