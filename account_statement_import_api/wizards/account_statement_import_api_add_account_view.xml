<odoo>

                  <record
        id="account_statement_import_api_add_account_form"
        model="ir.ui.view"
    >
                          <field
            name="model"
        >account.statement.import.api.add.account</field>
                          <field name="arch" type="xml">
                                  <form>
                                          <group name="main">
                                                  <field name="company_id" />
                                                  <field
                        name="statement_import_api_id"
                    />
                                                  <field name="service" />
                                                  <field name="state" invisible="1" />
                                          </group>
                                          <group name="url" states="url">
                                                <div colspan="2">
                                                        <p
                        >Open the URL below and follow the instructions to add one or several new API bank accounts.<br
                            />Once finished, come back to this wizard and click on the <strong
                            >Close</strong> button below.</p>
                                                </div>
                                                  <field name="url" widget="url" />
                                          </group>
                                          <footer>
                                                  <button
                        name="start2url"
                        type="object"
                        string="Start"
                        class="btn-primary"
                        states="start"
                    />
                                                  <button
                        name="finish"
                        type="object"
                        string="Close"
                        class="btn-primary"
                        states="url"
                    />
                                                  <button
                        special="cancel"
                        string="Cancel"
                        class="btn-default"
                        startes="start"
                    />
                                          </footer>
                                  </form>
                          </field>
                  </record>

                  <record
        id="account_statement_import_api_add_account_action"
        model="ir.actions.act_window"
    >
    <field name="name">Add API Account(s)</field>
    <field name="res_model">account.statement.import.api.add.account</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    </record>

          </odoo>
