<odoo>

                  <record
        id="account_statement_import_api_generate_url_form"
        model="ir.ui.view"
    >
                          <field
            name="model"
        >account.statement.import.api.generate.url</field>
                          <field name="arch" type="xml">
                                  <form>
                                          <group name="main">
                                                  <field name="company_id" />
                                                  <field
                        name="statement_import_api_id"
                    />
                                                  <field name="feature" />
                                                  <field
                        name="manage_api_account_id"
                        attrs="{'invisible': [('manage_api_account_required', '=', False)], 'required': [('manage_api_account_required', '=', True)]}"
                    />
                                                  <field name="state" invisible="1" />
                                                  <field
                        name="manage_api_account_required"
                        invisible="1"
                    />
                                          </group>
                                          <group name="url" states="url">
                                                  <div
                        colspan="2"
                        attrs="{'invisible': [('feature', '!=', 'add_account')]}"
                    >
                                                        <p
                        >Click on the URL below and follow the instructions to add one or several new API bank accounts.<br
                            />Once finished, come back here and click on the <strong
                            >Close</strong> button below.</p>
    </div>
    <div colspan="2" attrs="{'invisible': [('feature', '!=', 'manage_accounts')]}">
            <p>
                    Click on the URL below and follow the instructions to manage the API bank accounts.<br
                            />Once finished, come back here and click on the <strong
                            >Close</strong> button below.</p>
    </div>
                                                  <field name="url" widget="url" />
                                          </group>
                                          <footer>
                                                  <button
                        name="start2url"
                        type="object"
                        string="Start"
                        class="btn-primary"
                        states="start"
                    />
                                                  <button
                        name="finish"
                        type="object"
                        string="Close"
                        class="btn-primary"
                        states="url"
                    />
                                                  <button
                        special="cancel"
                        string="Cancel"
                        class="btn-default"
                        states="start"
                    />
                                          </footer>
                                  </form>
                          </field>
                  </record>

                  <record
        id="account_statement_import_api_generate_url_action"
        model="ir.actions.act_window"
    >
    <field name="name">Generate URL to Manage API Bank Account(s)</field>
    <field name="res_model">account.statement.import.api.generate.url</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    </record>

          </odoo>
