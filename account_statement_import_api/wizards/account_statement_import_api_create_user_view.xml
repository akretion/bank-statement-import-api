<odoo>

                  <record
        id="account_statement_import_api_create_user_form"
        model="ir.ui.view"
    >
                          <field
            name="model"
        >account.statement.import.api.create.user</field>
                          <field name="arch" type="xml">
                                  <form>
                                          <group name="main">
                                                  <field name="company_id" />
                                                  <field
                        name="statement_import_api_id"
                    />
                                                  <field name="service" />
                                          </group>
                                          <footer>
                                                  <button
                        name="run"
                        type="object"
                        string="Create User"
                        class="btn-primary"
                    />
                                                  <button
                        special="cancel"
                        string="Cancel"
                        class="btn-default"
                    />
                                          </footer>
                                  </form>
                          </field>
                  </record>

                  <record
        id="account_statement_import_api_create_user_action"
        model="ir.actions.act_window"
    >
    <field name="name">Create a New User</field>
    <field name="res_model">account.statement.import.api.create.user</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    </record>

          </odoo>
