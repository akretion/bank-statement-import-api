<odoo>

    <record id="account_statement_import_api_form" model="ir.ui.view">
        <field name="model">account.statement.import.api</field>
        <field
            name="inherit_id"
            ref="account_statement_import_api.account_statement_import_api_form"
        />
        <field name="arch" type="xml">
            <field name="login" position="before">
                <field
                    name="powens_hostname"
                    attrs="{'invisible': [('service', '!=', 'powens')], 'required': [('service', '=', 'powens')]}"
                />
            </field>
            <xpath
                expr="//field[@name='company_user_ids']/tree/field[@name='identifier']"
                position="after"
            >
                <field
                    name="powens_token"
                    attrs="{'column_invisible': [('parent.service', '!=', 'powens')]}"
                />
            </xpath>
        </field>
    </record>

</odoo>
