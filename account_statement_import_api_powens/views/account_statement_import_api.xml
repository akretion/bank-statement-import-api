<odoo>

    <record id="account_statement_import_api_form" model="ir.ui.view">
        <field name="model">account.statement.import.api</field>
        <field
            name="inherit_id"
            ref="account_statement_import_api.account_statement_import_api_form"
        />
        <field name="arch" type="xml">
            <field name="login" position="before">
                <field
                    name="powens_hostname"
                    invisible="service != 'powens'" required="service == 'powens'"
                />
                <field
                    name="powens_redirect_url"
                    invisible="service != 'powens'" required="service == 'powens'"
                />
                <field
                    name="powens_token"
                    invisible="service != 'powens'"
                />
            </field>
        </field>
    </record>

</odoo>
