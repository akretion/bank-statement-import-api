<odoo>

                  <record
        id="account_statement_import_api_account_form"
        model="ir.ui.view"
    >
                          <field
            name="model"
        >account.statement.import.api.account</field>
                          <field
            name="inherit_id"
            ref="account_statement_import_api.account_statement_import_api_account_form"
        />
                <field name="arch" type="xml">
                        <field name="identifier" position="after">
                                <field
                    name="powens_connection_identifier"
                    attrs="{'invisible': [('service', '!=', 'powens')]}"
                />
                        </field>
                </field>
        </record>

                  <record
        id="account_statement_import_api_account_list"
        model="ir.ui.view"
    >
                        <field name="model">account.statement.import.api.account</field>
                        <field
            name="inherit_id"
            ref="account_statement_import_api.account_statement_import_api_account_list"
        />
                        <field name="arch" type="xml">
                            <field name="identifier" position="after">
                                <field
                    name="powens_connection_identifier"
                    attrs="{'column_invisible': [('parent.service', '!=', 'powens')]}"
                    optional="hide"
                />
                            </field>
                    </field>
            </record>



          </odoo>
