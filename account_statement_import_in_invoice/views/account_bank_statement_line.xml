<odoo>

    <!-- kanban view -->
    <record id="bank_statement_line_reconcile_view" model="ir.ui.view">
        <field name="model">account.bank.statement.line</field>
        <field
            name="inherit_id"
            ref="account_reconcile_oca.bank_statement_line_reconcile_view"
        />
        <field name="arch" type="xml">
            <field name="is_reconciled" position="after">
                <field name="in_invoice_expense_description" />
                <field name="in_invoice_expense_categ_id" />
                <field name="in_invoice_account_id" />
                <field name="in_invoice_vat_rate" />
                <field name="in_invoice_tax_ids" />
                <field name="in_invoice_vat_amount" />
                <field name="in_invoice_card_id" />
                <field name="attachment_ids" />
            </field>
            <xpath
                expr="//templates//field[@name='payment_ref']/../.."
                position="after"
            >
                <div class="row" name="in_invoice">
                    <div class="col-8">
                        <div t-if="record.in_invoice_card_id.value">💳 <field
                                name="in_invoice_card_id"
                            /></div>
                        <div
                            t-if="record.in_invoice_expense_description.raw_value"
                        >✎ <field name="in_invoice_expense_description" /></div>
                        <div
                            t-if="record.in_invoice_card_id.value &amp;&amp; !record.in_invoice_expense_description.raw_value &amp;&amp; !record.is_reconciled.raw_value"
                            class="badge text-bg-warning"
                            style="font-weight: bold"
                        >
                                Missing ✎
                        </div>
                        <div
                            t-if="record.in_invoice_expense_description.raw_value or record.in_invoice_card_id.value"
                        >📂 <field name="in_invoice_expense_categ_id" /></div>
                        <div
                            t-if="(record.in_invoice_expense_description.raw_value or record.in_invoice_card_id.value) and record.in_invoice_account_id.raw_value"
                        >🗁  <field name="in_invoice_account_id" /></div>
                    </div>
                    <div
                        class="col-4"
                        style="text-align: right"
                        t-if="record.in_invoice_expense_description.raw_value or record.in_invoice_card_id.value"
                    >
                        <div t-if="record.in_invoice_tax_ids.raw_value.length > 0">
                        <field
                                name="in_invoice_tax_ids"
                                widget="many2many_tags"
                            /></div>
                        <div
                            t-if="record.in_invoice_tax_ids.raw_value.length === 0"
                        ><span style="font-weight: bold">VAT</span> <field
                                name="in_invoice_vat_rate"
                            /> %</div>
                                                <div><span
                                style="font-weight: bold"
                            >VAT</span> <field name="in_invoice_vat_amount" /></div>
                        <div t-if="record.attachment_ids.raw_value.length > 0">📷 <t
                                t-esc="record.attachment_ids.raw_value.length"
                            /></div>
                        <div
                            t-if="record.attachment_ids.raw_value.length === 0 &amp;&amp; !record.is_reconciled.raw_value"
                            class="badge text-bg-warning"
                            style="font-weight: bold"
                        >Missing 📷</div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="bank_statement_line_form_add_view" model="ir.ui.view">
        <field name="model">account.bank.statement.line</field>
        <field
            name="inherit_id"
            ref="account_reconcile_oca.bank_statement_line_form_add_view"
        />
        <field name="arch" type="xml">
            <xpath expr="/form/group" position="inside">
                <separator string="Vendor Bill" />
                <group name="in_invoice_left">
                                                  <field
                        name="in_invoice_expense_categ_id"
                    />
                                                  <field name="in_invoice_card_id" />
                                                  <field name="in_invoice_account_id" />
                                                    <field
                        name="in_invoice_analytic_distribution"
                        widget="analytic_distribution"
                        groups="analytic.group_analytic_accounting"
                        options="{'account_field': 'in_invoice_account_id'}"
                    />
                                                  <field
                        name="in_invoice_expense_description"
                    />
                                          </group>
                                          <group name="in_invoice_right">
                                                  <label for="in_invoice_vat_rate" />
                                                  <div name="in_invoice_vat_rate">
                                                          <field
                            name="in_invoice_vat_rate"
                            class="oe_inline"
                        /> %
                                                  </div>
                                                  <field
                        name="in_invoice_tax_ids"
                        widget="many2many_tags"
                    />
                                                  <field name="in_invoice_vat_amount" />
                                                  <field
                        name="in_invoice_force_invoice_date"
                    />
                                                  <field
                        name="in_invoice_receipt_lost"
                        attrs="{'invisible': [('attachment_ids', '!=', [])]}"
                    />
                                                  <field
                        name="attachment_ids"
                        widget="many2many_binary"
                        nolabel="1"
                        string="Receipt(s)"
                    />
                </group>
            </xpath>
        </field>
    </record>

    <!-- This is the view used on the right side of the bank statement reconcile interface -->
    <record id="bank_statement_line_form_reconcile_view" model="ir.ui.view">
        <field name="model">account.bank.statement.line</field>
        <field
            name="inherit_id"
            ref="account_reconcile_oca.bank_statement_line_form_reconcile_view"
        />
        <field name="arch" type="xml">
                                  <page name="manual" position="before">
                                          <page name="in_invoice" string="Vendor Bill">

                                          <group name="in_invoice_group">
                                                  <group name="in_invoice_left">
                                                          <field
                                name="in_invoice_id"
                                string="Created Vendor Bill"
                                attrs="{'invisible': [('in_invoice_id', '=', False)]}"
                            />
                                                  <field
                                name="in_invoice_expense_categ_id"
                                attrs="{'readonly': ['|', ('is_reconciled', '=', True), ('in_invoice_id', '!=', False)]}"
                            />
                                                  <field name="in_invoice_card_id" />
                                                  <field
                                name="in_invoice_account_id"
                                attrs="{'readonly': ['|', ('is_reconciled', '=', True), ('in_invoice_id', '!=', False)]}"
                            />
                                                    <field
                                name="in_invoice_analytic_distribution"
                                widget="analytic_distribution"
                                groups="analytic.group_analytic_accounting"
                                options="{'account_field': 'in_invoice_account_id'}"
                                attrs="{'readonly': ['|', ('is_reconciled', '=', True), ('in_invoice_id', '!=', False)]}"
                            />
                                                  <field
                                name="in_invoice_expense_description"
                                attrs="{'readonly': ['|', ('is_reconciled', '=', True), ('in_invoice_id', '!=', False)]}"
                            />
                                                  <field
                                name="attachment_ids"
                                widget="many2many_binary"
                                string="Receipt(s)"
                                attrs="{'readonly': ['|', ('is_reconciled', '=', True), ('in_invoice_id', '!=', False)]}"
                            />
                                                  <field
                                name="in_invoice_receipt_lost"
                                attrs="{'invisible': [('attachment_ids', '!=', [])], 'readonly': ['|', ('is_reconciled', '=', True), ('in_invoice_id', '!=', False)]}"
                            />
                                            </group>
                                            <group name="in_invoice_right">
                                                  <label for="in_invoice_vat_rate" />
                                                  <div name="in_invoice_vat_rate">
                                                          <field
                                    name="in_invoice_vat_rate"
                                    attrs="{'readonly': ['|', ('is_reconciled', '=', True), ('in_invoice_id', '!=', False)]}"
                                    class="oe_inline"
                                /> %
                                                  </div>
                                                  <field
                                name="in_invoice_tax_ids"
                                widget="many2many_tags"
                                attrs="{'readonly': ['|', ('is_reconciled', '=', True), ('in_invoice_id', '!=', False)]}"
                            />
                                                  <field
                                name="in_invoice_vat_amount"
                                attrs="{'readonly': ['|', ('is_reconciled', '=', True), ('in_invoice_id', '!=', False)]}"
                            />
                                                  <field
                                name="in_invoice_force_invoice_date"
                                attrs="{'readonly': ['|', ('is_reconciled', '=', True), ('in_invoice_id', '!=', False)]}"
                            />
                                                  <field
                                name="partner_id"
                                string="Force Vendor (optional)"
                                attrs="{'readonly': ['|', ('is_reconciled', '=', True), ('in_invoice_id', '!=', False)]}"
                            />

                                                  <field
                                name="in_invoice_show_button"
                                invisible="1"
                            />
                                            </group>
                                    </group>
                                    <group name="chatter">
                                            <field
                            name="move_id"
                            widget="account_reconcile_oca_chatter"
                            nolabel="1"
                            colspan="2"
                        />
                                    </group>
                                          </page>
                                  </page>
                                  <button
                name="unreconcile_bank_line"
                position="before"
            >
                                        <button
                    name="in_invoice_create"
                    string="Create Vendor Bill and Reconcile"
                    type="object"
                    colspan="2"
                    class="btn btn-secondary"
                    attrs="{'invisible': [('in_invoice_show_button', '=', False)]}"
                />
                                        <button
                    name="in_invoice_create_draft_button"
                    string="Create Draft Vendor Bill"
                    type="object"
                    colspan="2"
                    class="btn btn-secondary"
                    attrs="{'invisible': [('in_invoice_show_button', '=', False)]}"
                />
                                        <button
                    name="in_invoice_create_disabled"
                    string="Create Vendor Bill"
                    type="object"
                    colspan="2"
                    class="btn btn-secondary disabled"
                    attrs="{'invisible': [('in_invoice_show_button', '=', True)]}"
                />
                                  </button>
        </field>
    </record>

    <record id="account_bank_statement_line_form" model="ir.ui.view">
        <field name="model">account.bank.statement.line</field>
        <field
            name="inherit_id"
            ref="account_statement_base.account_bank_statement_line_form"
        />
        <field name="arch" type="xml">
            <notebook position="inside">
                                    <page name="in_invoice" string="Vendor Bills">
                                        <group name="in_invoice">
                                            <field name="in_invoice_expense_categ_id" />
                                              <field name="in_invoice_card_id" />
                                              <field name="in_invoice_account_id" />
                                                    <field
                            name="in_invoice_analytic_distribution"
                            widget="analytic_distribution"
                            groups="analytic.group_analytic_accounting"
                            options="{'account_field': 'in_invoice_account_id'}"
                        />
                                              <field name="in_invoice_vat_rate" />
                                              <field
                            name="in_invoice_tax_ids"
                            widget="many2many_tags"
                        />
                                              <field name="in_invoice_vat_amount" />
                                              <field
                            name="in_invoice_expense_description"
                        />
                                              <field
                            name="in_invoice_force_invoice_date"
                        />
                                          </group>
                                          <group
                        name="in_invoice_attach"
                        string="Receipt(s)"
                    >
                                              <field
                            name="attachment_ids"
                            widget="many2many_binary"
                            nolabel="1"
                            string="Receipt(s)"
                        />
                                          </group>
                                      </page>
            </notebook>
        </field>
    </record>

    <record id="account_bank_statement_line_tree" model="ir.ui.view">
        <field name="model">account.bank.statement.line</field>
        <field
            name="inherit_id"
            ref="account_statement_base.account_bank_statement_line_tree"
        />
        <field name="arch" type="xml">
            <field name="partner_bank_id" position="after">
                <field name="in_invoice_expense_categ_id" optional="hide" />
                <field name="in_invoice_card_id" optional="hide" />
                <field name="in_invoice_account_id" optional="hide" />
                <field
                    name="in_invoice_analytic_distribution"
                    widget="analytic_distribution"
                    groups="analytic.group_analytic_accounting"
                    optional="hide"
                />
                <field name="in_invoice_vat_rate" optional="hide" />
                <field
                    name="in_invoice_tax_ids"
                    widget="many2many_tags"
                    optional="hide"
                />
                <field name="in_invoice_vat_amount" optional="hide" />
                <field name="in_invoice_expense_description" optional="hide" />
                <field name="in_invoice_force_invoice_date" optional="hide" />
            </field>
        </field>
    </record>

</odoo>
