<odoo>

        <record id="account_bank_statement_card_form" model="ir.ui.view">
                <field name="model">account.bank.statement.card</field>
                <field name="arch" type="xml">
                        <form>
                                <sheet>
                                <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                                <div class="oe_title">
                    <label for="name" />
                    <h1>
                            <field name="name" />
                    </h1>
            </div>
                            <group name="main">
                                    <field name="code" />
                                    <field
                            name="company_id"
                            groups="base.group_multi_company"
                        />
                                    <field name="company_id" invisible="1" />
                                    <field name="journal_id" />
                                    <field
                            name="misc_partner_id"
                            context="{'default_is_company': True}"
                        />
                                    <field name="active" invisible="1" />
                            </group>
                    </sheet>
                    </form>
                </field>
        </record>

        <record id="account_bank_statement_card_list" model="ir.ui.view">
                <field name="model">account.bank.statement.card</field>
                <field name="arch" type="xml">
                        <tree>
                                    <field name="code" />
                                <field name="name" decoration-bf="1" />
                                    <field name="journal_id" />
                                    <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company"
                />
                        <field name="misc_partner_id" optional="show" />
                    </tree>
                </field>
        </record>

        <record id="account_bank_statement_card_search" model="ir.ui.view">
                <field name="model">account.bank.statement.card</field>
                <field name="arch" type="xml">
                    <search>
                            <field
                    name="name"
                    filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"
                    string="Label or Code"
                />
                            <field name="journal_id" />
                        <separator />
                        <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
                        <group name="groupby">
                            <filter
                        name="journal_groupby"
                        string="Bank Journal"
                        context="{'group_by': 'journal_id'}"
                    />
                        </group>
                   </search>
            </field>
        </record>

        <record id="account_bank_statement_card_action" model="ir.actions.act_window">
                <field name="name">Bank Cards</field>
                <field name="res_model">account.bank.statement.card</field>
                <field name="view_mode">tree,form</field>
        </record>

        <menuitem
        id="account_bank_statement_card_menu"
        action="account_bank_statement_card_action"
        parent="account.account_banks_menu"
        sequence="120"
    />

</odoo>
