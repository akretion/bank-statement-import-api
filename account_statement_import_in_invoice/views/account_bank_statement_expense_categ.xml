<odoo>

        <record id="account_bank_statement_expense_categ_form" model="ir.ui.view">
                <field name="model">account.bank.statement.expense.categ</field>
                <field name="arch" type="xml">
                        <form>
                                <sheet>
                                <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                                <div class="oe_title">
                    <label for="name" />
                    <h1>
                            <field name="name" />
                    </h1>
            </div>
                            <group name="main">
                                    <field name="service" />
                                    <field name="code" string="Code (do not modify)" />
                                    <field name="account_id" />
                                    <field name="active" invisible="1" />
                            </group>
                            <group
                        name="card_account_ids"
                        string="Card-specific Accounts"
                    >
                                    <field
                            name="card_account_ids"
                            nolabel="1"
                            colspan="2"
                        >
                                            <tree editable="bottom">
                                                    <field
                                    name="company_id"
                                    invisible="1"
                                />
                                                    <field name="card_id" />
                                                    <field name="account_id" />
                                            </tree>
                                    </field>
                            </group>
                    </sheet>
                    </form>
                </field>
        </record>

        <record id="account_bank_statement_expense_categ_list" model="ir.ui.view">
                <field name="model">account.bank.statement.expense.categ</field>
                <field name="arch" type="xml">
                        <tree>
                                <field name="name" decoration-bf="1" />
                                    <field name="service" />
                                    <field name="code" />
                                    <field name="account_id" />
                    </tree>
                </field>
        </record>

        <record id="account_bank_statement_expense_categ_search" model="ir.ui.view">
                <field name="model">account.bank.statement.expense.categ</field>
                <field name="arch" type="xml">
                    <search>
                        <field
                    name="name"
                    filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"
                    string="Label or Code"
                />
                        <separator />
                        <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
                        <group name="groupby">
                            <filter
                        name="service_groupby"
                        string="Service"
                        context="{'group_by': 'service'}"
                    />
                        </group>
                   </search>
            </field>
        </record>

        <record
        id="account_bank_statement_expense_categ_action"
        model="ir.actions.act_window"
    >
                <field name="name">Bank Statement Expense Categories</field>
                <field name="res_model">account.bank.statement.expense.categ</field>
                <field name="view_mode">tree,form</field>
        </record>

        <menuitem
        id="account_bank_statement_expense_categ_menu"
        action="account_bank_statement_expense_categ_action"
        parent="account.account_banks_menu"
        sequence="80"
    />

</odoo>
