<odoo>

        <record id="account_bank_statement_analytic_account_form" model="ir.ui.view">
                <field name="model">account.bank.statement.analytic.account</field>
                <field name="arch" type="xml">
                        <form>
                                <sheet>
                                <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                                <div class="oe_title">
                    <label for="name" />
                    <h1>
                            <field name="name" />
                    </h1>
            </div>
                            <group name="main">
                                    <field name="parent_name" />
                                    <field name="statement_import_api_id" />
                                    <field
                            name="identifier"
                            string="Identifier (do not modify)"
                        />
                                    <field name="analytic_account_id" />
                                    <field name="active" invisible="1" />
                                    <field name="company_id" invisible="1" />
                                    <field
                            name="company_id"
                            groups="base.group_multi_company"
                        />
                            </group>
                    </sheet>
                    </form>
                </field>
        </record>

        <record id="account_bank_statement_analytic_account_list" model="ir.ui.view">
                <field name="model">account.bank.statement.analytic.account</field>
                <field name="arch" type="xml">
                        <tree decoration-warning="not analytic_account_id">
                                <field name="name" decoration-bf="1" />
                                    <field name="parent_name" />
                                    <field name="statement_import_api_id" />
                                    <field name="service" optional="hide" />
                                    <field name="identifier" optional="show" />
                                    <field name="analytic_account_id" />
                                    <field
                    name="company_id"
                    groups="base.group_multi_company"
                />
                    </tree>
                </field>
        </record>

        <record id="account_bank_statement_analytic_account_search" model="ir.ui.view">
                <field name="model">account.bank.statement.analytic.account</field>
                <field name="arch" type="xml">
                    <search>
                        <field
                    name="name"
                    string="Label or Parent Label"
                    filter_domain="['|', ('name', 'ilike' self), ('parent_name', 'ilike', self)]"
                />
                        <separator />
                        <filter
                    string="Not Configured"
                    name="no_analytic_account"
                    domain="[('analytic_account_id', '=', False)]"
                />
                        <filter
                    string="Fuly Configured"
                    name="analytic_account"
                    domain="[('analytic_account_id', '!=', False)]"
                />

                    <separator />
                        <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
                        <group name="groupby">
                            <filter
                        name="service_groupby"
                        string="Service"
                        context="{'group_by': 'service'}"
                    />
                            <filter
                        name="parent_groupby"
                        string="Parent"
                        context="{'group_by': 'parent_name'}"
                    />
                            <filter
                        name="statement_api_groupby"
                        string="Statement Import API"
                        context="{'group_by': 'statement_import_api_id'}"
                    />
                        </group>
                   </search>
            </field>
        </record>

    <record
        id="account_bank_statement_analytic_account_action"
        model="ir.actions.act_window"
    >
                <field name="name">Bank Statement Analytic Account</field>
                <field name="res_model">account.bank.statement.analytic.account</field>
                <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="account_bank_statement_analytic_account_menu"
        action="account_bank_statement_analytic_account_action"
        groups="analytic.group_analytic_accounting"
        parent="account.account_banks_menu"
        sequence="90"
    />

</odoo>
