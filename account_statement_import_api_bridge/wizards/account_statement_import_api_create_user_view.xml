<odoo>

    <record id="account_statement_import_api_create_user_form" model="ir.ui.view">
        <field name="model">account.statement.import.api.create.user</field>
        <field
            name="inherit_id"
            ref="account_statement_import_api.account_statement_import_api_create_user_form"
        />
