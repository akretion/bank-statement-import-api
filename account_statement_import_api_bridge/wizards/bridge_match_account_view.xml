<odoo>

    <record id="bridge_match_account_form" model="ir.ui.view">
        <field name="model">bridge.match.account</field>
        <field name="arch" type="xml">
            <form>
                <group name="main">
                    <field name="journal_id" />
                    <field name="option_id" required="1" />
                </group>
                <group name="options" string="Available Bridge Accounts">
                    <field name="option_ids" nolabel="1" colspan="2">
                        <tree>
                            <field name="name" />
                            <field name="iban" />
                            <field name="bridge_provider_name" />
                            <field name="account_type" />
                            <field
                                name="bridge_identifier"
                                groups="base.group_no_one"
                            />
                        </tree>
                    </field>
                </group>
                <footer>
                    <button
                        name="run"
                        type="object"
                        string="Select"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-default" />
                </footer>
            </form>
        </field>
    </record>


</odoo>
