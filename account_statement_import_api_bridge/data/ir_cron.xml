<odoo noupdate="1">

<record id="account_statement_import_api_bridge_cron" model="ir.cron">
    <field name="name">BridgeAPI Bank Statement Import API</field>
    <field name="active" eval="False" />
    <field name="user_id" ref="base.user_root" />
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="numbercall">-1</field> <!-- remove in v18 -->
    <field
            name="model_id"
            ref="account_statement_import_api.model_account_statement_import_api"
        />
    <field name="state">code</field>
    <field name="code">model.cron_run("bridge")</field>
</record>

</odoo>
