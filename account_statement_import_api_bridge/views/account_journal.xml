<odoo>

    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="model">account.journal</field>
        <field
            name="inherit_id"
            ref="account_statement_import_api.view_account_journal_form"
        />
        <field name="arch" type="xml">
                <field name="statement_import_api_last_success" position="after">
                    <field
                    name="bridge_preferred_date"
                    invisible="statement_import_api_service != 'bridge'"
                />
            </field>
        </field>
    </record>

</odoo>
